#!/bin/sh

# Test that a greyscale+alpha PAM file round-trips:
# PAM -> PNG -> PAM is byte-for-byte identical,
# and the alpha channel is not confused with the grey channel.

PATH=${PWD%code*}code:$PATH

t=$(mktemp)
trap 'rm -f "$t"' EXIT

{
  printf 'P7\n'
  printf 'WIDTH 2\nHEIGHT 1\nDEPTH 2\nMAXVAL 255\n'
  printf 'TUPLTYPE GRAYSCALE_ALPHA\n'
  printf 'ENDHDR\n'
  printf '\310\377\050\000'
} > "$t"

pripamtopng "$t" |
pripngtopam - |
cmp - "$t"
