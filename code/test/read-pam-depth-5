#!/bin/sh

# Test that pripamtopng fails explicitly (does not silently
# misinterpret the channels) for a PAM with an unsupported DEPTH.

PATH=${PWD%code*}code:$PATH

{
  printf 'P7\n'
  printf 'WIDTH 2\nHEIGHT 1\nDEPTH 5\nMAXVAL 255\n'
  printf 'ENDHDR\n'
  printf '\0\1\2\3\4\5\6\7\10\11'
} |
pripamtopng - 2>/dev/null

test $? -ne 0
